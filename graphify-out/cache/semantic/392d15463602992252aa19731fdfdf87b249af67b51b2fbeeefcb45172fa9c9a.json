{"nodes": [{"id": "plans_2026_06_24_prod_docker_nginx_backups_plan", "label": "Prod Docker nginx Backups Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-06-24-prod-docker-nginx-backups.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_06_24_prod_docker_nginx_backups_compose_prod", "label": "docker-compose.prod.yml Hardened Production Stack", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-24-prod-docker-nginx-backups.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promotes docker-compose.vps.yml into docker-compose.prod.yml adding Redis, healthchecks with service_healthy conditions, resource limits, log rotation, and pinned postgres:15.4-alpine image to match staging hardening"}, {"id": "plans_2026_06_24_prod_docker_nginx_backups_backup_sh", "label": "Backup Shell Script", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-24-prod-docker-nginx-backups.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces single-file-overwrite approach with timestamped DB+uploads pairs; uploads volume previously had no backup path; shared timestamp makes pairs identifiable; retention pruning keeps last 15"}, {"id": "plans_2026_06_24_prod_docker_nginx_backups_restore_sh", "label": "Restore Shell Script", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-24-prod-docker-nginx-backups.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_06_24_prod_docker_nginx_backups_systemd_timer", "label": "Systemd Backup Timer Units", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-24-prod-docker-nginx-backups.md", "source_location": "Task 7", "source_url": null, "captur